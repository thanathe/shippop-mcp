# Copy to .env (gitignored) for local testing with scripts/live-smoke.ts.
# For Claude Desktop / Claude Code put the same values in the MCP server "env" block instead.

# --- Domestic (required) ---
SHIPPOP_API_KEY=your-marketplace-api-key
SHIPPOP_EMAIL=you@example.com
# dev (default, sandbox) | production (REAL money)
#   dev        -> https://mkpservice.shippop.dev   (domestic)  / https://inter.shippop.dev  (crossborder)
#   production -> https://mkpservice.shippop.com   (domestic)  / https://inter.shippop.com  (crossborder)
SHIPPOP_ENV=dev

# --- Crossborder / SHIPPOP Inter (optional — enables shippop_inter_* tools) ---
# These are your SHIPPOP account LOGIN credentials (email + password), not the API key.
#SHIPPOP_INTER_USERNAME=you@example.com
#SHIPPOP_INTER_PASSWORD=your-shippop-password

# --- Optional ---
#SHIPPOP_LABEL_DIR=/path/to/labels
# Override the base URLs (normally derived from SHIPPOP_ENV above — leave commented out)
#SHIPPOP_BASE_URL=https://mkpservice.shippop.com
#SHIPPOP_INTER_BASE_URL=https://inter.shippop.com
#SHIPPOP_TIMEOUT_MS=20000
#SHIPPOP_CONFIRM_TIMEOUT_MS=60000
